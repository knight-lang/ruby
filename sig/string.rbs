module Knight
  # The string class in Knight.
  class Str < Literal[String]
    # Parses a `Str` from the `stream`, returning `None` if the
    # nothing can be parsed.
    #
    # If a starting quote is matched and no ending quote is, then a
    # `ParseError` will be raised.
    def self.parse: (Stream stream) -> instance?

    def truthy?: () -> boolish

    def to_a: () -> Array[Str]

    def to_i: () -> Integer

    def +: (_ToS other) -> Str
    def *: (_ToI count) -> Str
    def <=>: (untyped rhs) -> Integer?

    def []: (__todo__ index) -> Str
  end
end
